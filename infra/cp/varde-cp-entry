#!/bin/sh
# LiteFS exec entrypoint — runs only after the node is primary or connected
# to the primary. VARDE_NODE_NAME must equal litefs.yml's lease.hostname so
# the CP's reconciler gate (VARDE_PRIMARY_FILE) knows whether this node
# holds the write lease.
export VARDE_NODE_NAME="${FLY_MACHINE_ID}.vm.${FLY_APP_NAME}.internal"
exec /varde-control-plane "$@"
