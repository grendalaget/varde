{
  "name": "@varde/dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./App": "./src/App.tsx",
    "./api/client": "./src/api/client.ts",
    "./api/schema": "./src/api/schema.d.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/activity": "./src/lib/activity.ts",
    "./lib/config-defaults": "./src/lib/config-defaults.ts",
    "./lib/configField": "./src/lib/configField.ts",
    "./lib/data": "./src/lib/data.ts",
    "./lib/events": "./src/lib/events.tsx",
    "./lib/format": "./src/lib/format.ts",
    "./lib/games": "./src/lib/games.ts",
    "./lib/router": "./src/lib/router.tsx",
    "./lib/session": "./src/lib/session.tsx",
    "./pages/*": "./src/pages/*.tsx"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../../api/openapi/control-plane.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.15.0"
  },
  "peerDependencies": {
    "@heroui/react": "^3.2.6",
    "@varde/ui": "^0.1.0",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@heroui/react": "^3.2.6",
    "@types/react": "^19.1.0",
    "@varde/ui": "workspace:*",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.6.0",
    "react": "^19.1.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.37.0",
    "vite": "^7.1.0"
  }
}
