{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Varde",
  "version": "0.1.0",
  "identifier": "games.varde.tray",
  "mainBinaryName": "varde-tray",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "licenseFile": "../../LICENSE",
    "publisher": "Varde contributors",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
