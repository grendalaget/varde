{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Varde",
  "version": "0.1.0",
  "identifier": "games.varde.tray",
  "mainBinaryName": "varde-tray",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "licenseFile": "../../LICENSE",
    "publisher": "Varde contributors",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "../../packaging/windows/varde.ico",
        "sidebarImage": "../../packaging/windows/wizard/wizard.bmp",
        "headerImage": "installer-hooks/header.bmp",
        "template": "installer-hooks/installer.nsi",
        "installerHooks": "installer-hooks/hooks.nsh",
        "compression": "lzma"
      }
    }
  }
}