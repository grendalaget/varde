{
  "name": "@varde/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "gen:api": "openapi-typescript ../../api/openapi/control-plane.yaml -o src/api/schema.d.ts",
    "postinstall": "node node_modules/@heroui-pro/react/dist/postinstall/index.js || true"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@heroui-pro/react": "1.0.0-beta.10",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "openapi-fetch": "^0.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.37.0",
    "vite": "^7.1.0"
  }
}
