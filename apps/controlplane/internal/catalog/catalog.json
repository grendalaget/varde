[
  {
    "id": "autotournament",
    "name": "Auto Tournament",
    "ports": [{ "port": 3069, "protocol": "tcp" }],
    "os": ["linux"],
    "arch": ["x86_64"],
    "min_memory_mb": 2048,
    "min_disk_mb": 2048,
    "runtimes": ["native"],
    "config_fields": [
      { "name": "public_url", "label": "Public URL", "type": "string", "required": true, "help": "HTTP(S) origin, without a path prefix" },
      { "name": "licence", "label": "Accept the Auto Tournament licence", "type": "select", "options": ["noncommercial", "commercial"], "required": true },
      { "name": "api_token", "label": "API token", "type": "secret", "secret": true, "required": false, "help": "At least 16 URL-safe characters; generated and persisted when absent" },
      { "name": "steam_web_api_key", "label": "Steam Web API key", "type": "secret", "secret": true, "required": false }
    ]
  },
  {
    "id": "testgame",
    "name": "Test Game",
    "ports": [
      { "port": 7777, "protocol": "tcp" },
      { "port": 7777, "protocol": "udp" }
    ],
    "os": ["linux", "windows"],
    "arch": ["x86_64", "aarch64"],
    "min_memory_mb": 64,
    "runtimes": ["native"],
    "addon_targets": ["server"],
    "config_fields": [
      { "name": "message", "type": "string", "default": "hello", "required": false, "help": "text the test server echoes" },
      { "name": "tick_rate", "type": "int", "default": 20, "required": false }
    ]
  },
  {
    "id": "minecraft",
    "name": "Minecraft (Java)",
    "ports": [{ "port": 25565, "protocol": "tcp" }],
    "os": ["linux", "windows"],
    "arch": ["x86_64", "aarch64"],
    "min_memory_mb": 2048,
    "runtimes": ["java"],
    "config_fields": [
      { "name": "version", "type": "select", "options": ["1.21.4", "1.21.1", "1.20.6"], "default": "1.21.4", "required": true },
      { "name": "eula_accepted", "label": "Accept the Minecraft EULA", "type": "bool", "default": false, "required": true, "help": "you must accept the Minecraft EULA to run a server" },
      { "name": "max_players", "type": "int", "default": 20, "required": false },
      { "name": "difficulty", "type": "select", "options": ["peaceful", "easy", "normal", "hard"], "default": "normal" },
      { "name": "gamemode", "label": "Game mode", "type": "select", "options": ["survival", "creative", "adventure", "spectator"], "default": "survival" },
      { "name": "view_distance", "label": "View distance (chunks)", "type": "int", "default": 10 },
      { "name": "online_mode", "type": "bool", "default": false, "help": "off for peer-hosted play without Mojang auth" },
      { "name": "motd", "label": "Message of the day", "type": "string", "default": "A Varde server" },
      { "name": "seed", "label": "World seed", "type": "string", "required": false }
    ]
  },
  {
    "id": "cs2",
    "name": "Counter-Strike 2 Dedicated",
    "ports": [{ "port": 27015, "protocol": "udp" }],
    "os": ["linux", "windows"],
    "arch": ["x86_64"],
    "min_memory_mb": 4096,
    "min_disk_mb": 75000,
    "steam_app": 730,
    "runtimes": ["steamcmd"],
    "addon_targets": ["game"],
    "addon_target_os": {"game": ["linux"]},
    "config_fields": [
      { "name": "server_name", "type": "string", "required": true },
      { "name": "password", "type": "secret", "secret": true, "required": false },
      { "name": "game_mode", "type": "select", "options": ["casual", "competitive", "wingman", "arms_race", "deathmatch"], "default": "competitive" },
      { "name": "map", "type": "string", "default": "de_dust2" },
      { "name": "max_players", "type": "int", "default": 10, "min": 2, "max": 64 },
      { "name": "bots", "type": "int", "default": 0, "min": 0, "max": 64, "help": "0 for none" },
      { "name": "gslt", "label": "Steam server token (GSLT)", "type": "secret", "secret": true, "required": false, "help": "Steam Game Server Login Token; without it the server is LAN-only (connections through Varde count as local)" }
    ]
  },
  {
    "id": "valheim",
    "name": "Valheim Dedicated",
    "ports": [
      { "port": 2456, "protocol": "udp" },
      { "port": 2457, "protocol": "udp" }
    ],
    "os": ["linux", "windows"],
    "arch": ["x86_64"],
    "min_memory_mb": 2048,
    "runtimes": ["steamcmd"],
    "config_fields": [
      { "name": "server_name", "type": "string", "required": true },
      { "name": "world_name", "type": "string", "required": true },
      { "name": "password", "type": "secret", "required": true, "secret": true, "help": "server password (5+ chars)" },
      { "name": "public", "label": "List publicly", "type": "bool", "default": false, "help": "list on Steam community servers" },
      { "name": "crossplay", "type": "bool", "default": false, "help": "Crossplay (Xbox/PS5/Game Pass): players join with a join code instead of the Varde address" },
      { "name": "modifiers", "label": "World modifiers", "type": "select", "options": ["normal", "casual", "easy", "hard", "hardcore", "immersive", "hammer"], "default": "normal" },
      { "name": "save_interval_s", "label": "World save interval (seconds)", "type": "int", "default": 300, "min": 60, "max": 3600, "help": "60 to 3600" }
    ]
  }
]
