[
  {
    "id": "testgame",
    "name": "Test Game",
    "ports": [
      { "port": 7777, "protocol": "tcp" },
      { "port": 7777, "protocol": "udp" }
    ],
    "os": ["linux", "windows"],
    "arch": ["x86_64", "aarch64"],
    "min_memory_mb": 64,
    "runtimes": ["native"],
    "config_fields": [
      { "name": "message", "type": "string", "default": "hello", "required": false, "help": "text the test server echoes" },
      { "name": "tick_rate", "type": "int", "default": 20, "required": false }
    ]
  },
  {
    "id": "minecraft",
    "name": "Minecraft (Java)",
    "ports": [{ "port": 25565, "protocol": "tcp" }],
    "os": ["linux", "windows"],
    "arch": ["x86_64", "aarch64"],
    "min_memory_mb": 2048,
    "runtimes": ["java"],
    "config_fields": [
      { "name": "version", "type": "select", "options": ["1.21.4", "1.21.1", "1.20.6"], "default": "1.21.4", "required": true },
      { "name": "eula_accepted", "type": "bool", "default": false, "required": true, "help": "you must accept the Minecraft EULA to run a server" },
      { "name": "max_players", "type": "int", "default": 20, "required": false },
      { "name": "difficulty", "type": "select", "options": ["peaceful", "easy", "normal", "hard"], "default": "normal" },
      { "name": "gamemode", "type": "select", "options": ["survival", "creative", "adventure", "spectator"], "default": "survival" },
      { "name": "view_distance", "type": "int", "default": 10 },
      { "name": "online_mode", "type": "bool", "default": false, "help": "off for peer-hosted play without Mojang auth" },
      { "name": "motd", "type": "string", "default": "A Varde server" },
      { "name": "seed", "type": "string", "required": false }
    ]
  },
  {
    "id": "valheim",
    "name": "Valheim Dedicated",
    "ports": [
      { "port": 2456, "protocol": "udp" },
      { "port": 2457, "protocol": "udp" }
    ],
    "os": ["linux", "windows"],
    "arch": ["x86_64"],
    "min_memory_mb": 2048,
    "runtimes": ["steamcmd"],
    "config_fields": [
      { "name": "server_name", "type": "string", "required": true },
      { "name": "world_name", "type": "string", "required": true },
      { "name": "password", "type": "secret", "required": true, "secret": true, "help": "server password (5+ chars)" },
      { "name": "public", "type": "bool", "default": false, "help": "list on Steam community servers" },
      { "name": "crossplay", "type": "bool", "default": false, "help": "Crossplay (Xbox/PS5/Game Pass): players join with a join code instead of the Varde address" },
      { "name": "modifiers", "type": "select", "options": ["normal", "casual", "easy", "hard", "hardcore", "immersive", "hammer"], "default": "normal" },
      { "name": "save_interval_s", "type": "int", "default": 300, "min": 60, "max": 3600, "help": "seconds between Valheim world saves (60-3600)" }
    ]
  }
]
