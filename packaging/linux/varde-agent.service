[Unit]
Description=Varde node agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=varde
ExecStart=/usr/bin/varde-agent run
# the agent drains executions before stopping: a warm handoff of Minecraft
# servers (default 45 s), else final snapshot + replication hold (default 60 s);
# give it both plus stop overhead before SIGKILL
TimeoutStopSec=150
Restart=always
RestartSec=5
StateDirectory=varde
StateDirectoryMode=0700
ConfigurationDirectory=varde
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/varde /etc/varde

[Install]
WantedBy=multi-user.target
