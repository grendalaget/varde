[Unit]
Description=Varde node agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=varde
ExecStart=/usr/bin/varde-agent run
Restart=always
RestartSec=5
StateDirectory=varde
StateDirectoryMode=0700
ConfigurationDirectory=varde
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/varde /etc/varde

[Install]
WantedBy=multi-user.target
