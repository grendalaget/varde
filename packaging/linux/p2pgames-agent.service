[Unit]
Description=p2pgames node agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/p2pgames-agent run
Restart=always
RestartSec=5
StateDirectory=p2pgames
StateDirectoryMode=0700
ConfigurationDirectory=p2pgames
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/p2pgames /etc/p2pgames

[Install]
WantedBy=multi-user.target
