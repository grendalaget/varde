<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Menubar app: no dock icon. The main window still shows normally. -->
	<key>LSUIElement</key>
	<true/>
	<!-- varde:// deep links (federated sign-in callback) arrive as
	     RunEvent::Opened — claimed by the bundle, not the registry. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>games.varde.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>varde</string>
			</array>
		</dict>
	</array>
	<!-- The launchd label of the agent the tray manages; readable by
	     tooling and support docs. -->
	<key>VardeAgentLabel</key>
	<string>games.varde.agent</string>
</dict>
</plist>
